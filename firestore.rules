/**
 * Core Philosophy: This ruleset enforces a strict user-ownership model combined with
 * read-only public content. The primary security goal is to ensure that a user's
 * private data (profile, progress, scores, achievements) is completely isolated and
 * accessible only to that user.
 *
 * Data Structure: The data is segregated into two main categories:
 * 1. Private User Data: All data specific to a user is nested under the path
 *    /users/{userId}. This includes their profile, learning progress, quiz scores,
 *    and earned achievements. This structure is key to our security model.
 * 2. Public Content: General learning materials like topics, lessons, quizzes,
 *    and available badges are stored in top-level collections (/learningTopics,
 *    /achievementBadges).
 *
 * Key Security Decisions:
 * - Strict Ownership: A user has full control (CRUD) over their own data located
 *   under /users/{userId}, but no access to any other user's data.
 * - Public Content is Read-Only: All signed-in users can read learning content
 *   and available badges, but cannot write to these collections. This prevents
 *   client-side tampering with shared educational materials. Content management
 *   is expected to be handled by a trusted backend or through the Firebase Console.
 * - No User Enumeration: Listing documents from the root /users collection is
 *   explicitly disabled to protect user privacy.
 * - Authorization over Validation: In this prototyping phase, rules focus on
 *   "who" can access data, not the specific "shape" of the data. Validation is
 *   limited to fields critical for maintaining ownership and relational integrity.
 *
 * Denormalization for Authorization: The structure inherently supports simple rules
 * by nesting user-specific data under their user ID. This avoids costly `get()`
 * calls to check ownership. For instance, a rule on `/users/{userId}/quizScores/{scoreId}`
 * can authorize based on the `{userId}` in the path without needing to read another document.
 *
 * Structural Segregation: The design uses separate collections for private user data
 * (/users) and public content (/learningTopics, /achievementBadges). This is a highly
 * secure and performant pattern that prevents accidental data leakage and simplifies
 * list operation security.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    //-------------------------------------------------------------------------
    // Helper Functions
    //-------------------------------------------------------------------------

    /**
     * isSignedIn
     * Checks if the user is authenticated.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * isOwner
     * Checks if the authenticated user's UID matches the provided userId.
     * This is the foundation of the user-ownership model.
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /**
     * isExistingOwner
     * Confirms ownership AND that the document already exists.
     * Crucial for secure update and delete operations.
     */
    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }

    /**
     * isNewUserDocumentValid
     * Validates that the user's root document has the correct ID on creation.
     */
    function isNewUserDocumentValid(userId) {
      return request.resource.data.id == userId;
    }

    /**
     * isUserDataConsistent
     * Validates that a subcollection document has the correct owner ID on creation.
     */
    function isNewUserDataConsistent(userId) {
      return request.resource.data.userId == userId;
    }

    /**
     * isUserIdImmutable
     * Ensures the userId field cannot be changed on update.
     */
    function isUserIdImmutable() {
      return request.resource.data.userId == resource.data.userId;
    }
    
    /**
     * isUserIdFieldImmutable
     * Ensures the id field cannot be changed on update.
     */
    function isIdFieldImmutable() {
      return request.resource.data.id == resource.data.id;
    }

    //-------------------------------------------------------------------------
    // User Data Collections
    //-------------------------------------------------------------------------

    /**
     * @description Controls access to a user's own profile document.
     * @path /users/{userId}
     * @allow A user (auth.uid: 'user123') creating their own profile at /users/user123. (create)
     * @deny A user (auth.uid: 'user456') trying to read the profile at /users/user123. (get)
     * @principle Restricts access to a user's own data tree and allows self-creation of a profile.
     */
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false; // Prevent user enumeration
      allow create: if isOwner(userId) && isNewUserDocumentValid(userId);
      allow update: if isExistingOwner(userId) && isIdFieldImmutable();
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Secures a user's learning progress records.
     * @path /users/{userId}/learningProgress/{progressId}
     * @allow The owner (auth.uid: 'user123') creating a new progress record. (create)
     * @deny Another user (auth.uid: 'user456') trying to update a record for 'user123'. (update)
     * @principle Enforces document ownership for all operations within a user's private subcollection.
     */
    match /users/{userId}/learningProgress/{progressId} {
      allow get, list: if isOwner(userId);
      allow create: if isOwner(userId) && isNewUserDataConsistent(userId);
      allow update: if isExistingOwner(userId) && isUserIdImmutable();
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Secures a user's quiz score records.
     * @path /users/{userId}/quizScores/{scoreId}
     * @allow The owner (auth.uid: 'user123') reading their own list of scores. (list)
     * @deny An anonymous user trying to create a score record. (create)
     * @principle Enforces document ownership for all operations within a user's private subcollection.
     */
    match /users/{userId}/quizScores/{scoreId} {
      allow get, list: if isOwner(userId);
      allow create: if isOwner(userId) && isNewUserDataConsistent(userId);
      allow update: if isExistingOwner(userId) && isUserIdImmutable();
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Secures a user's earned achievement records.
     * @path /users/{userId}/achievements/{achievementId}
     * @allow The owner (auth.uid: 'user123') deleting one of their achievements. (delete)
     * @deny Another user (auth.uid: 'user456') trying to read an achievement for 'user123'. (get)
     * @principle Enforces document ownership for all operations within a user's private subcollection.
     */
    match /users/{userId}/achievements/{achievementId} {
      allow get, list: if isOwner(userId);
      allow create: if isOwner(userId) && isNewUserDataConsistent(userId);
      allow update: if isExistingOwner(userId) && isUserIdImmutable();
      allow delete: if isExistingOwner(userId);
    }

    //-------------------------------------------------------------------------
    // Public Content Collections
    //-------------------------------------------------------------------------

    /**
     * @description Public, read-only collection of all available learning topics.
     * @path /learningTopics/{topicId}
     * @allow Any signed-in user reading a topic document. (get)
     * @deny Any user, signed-in or not, trying to create a new topic. (create)
     * @principle Protects shared application content from client-side modification.
     */
    match /learningTopics/{topicId} {
      allow get, list: if isSignedIn();
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Public, read-only collection of micro-lessons for a given topic.
     * @path /learningTopics/{topicId}/microLessons/{lessonId}
     * @allow Any signed-in user listing all lessons for a topic. (list)
     * @deny Any user trying to delete a lesson. (delete)
     * @principle Protects shared application content from client-side modification.
     */
    match /learningTopics/{topicId}/microLessons/{lessonId} {
      allow get, list: if isSignedIn();
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Public, read-only collection of quizzes for a given topic.
     * @path /learningTopics/{topicId}/quizzes/{quizId}
     * @allow Any signed-in user reading a specific quiz. (get)
     * @deny Any user trying to update a quiz. (update)
     * @principle Protects shared application content from client-side modification.
     */
    match /learningTopics/{topicId}/quizzes/{quizId} {
      allow get, list: if isSignedIn();
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Public, read-only collection of all available achievement badges.
     * @path /achievementBadges/{badgeId}
     * @allow Any signed-in user listing all available badges. (list)
     * @deny Any user trying to create a new badge. (create)
     * @principle Protects shared application content from client-side modification.
     */
    match /achievementBadges/{badgeId} {
      allow get, list: if isSignedIn();
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }
  }
}